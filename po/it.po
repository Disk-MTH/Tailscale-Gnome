#: prefs.js:185
msgid "Send and receive files between Tailscale nodes."
msgstr "Invia e ricevi file tra nodi Tailscale."

#: prefs.js:225
msgid "Inbox folder (created if it does not exist)"
msgstr "Cartella di ricezione (creata se non esiste)"

#: prefs.js:241
msgid "Path is empty or not writable without admin privileges."
msgstr ""
"Il percorso è vuoto o non è scrivibile senza privilegi di amministratore."

