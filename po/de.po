msgid "All"
msgstr "Alle"

#: prefs.js:801
msgid "Report everything this category produces"
msgstr "Alles melden, was diese Kategorie erzeugt"

#: prefs.js:808
msgid "Report only failures and warnings"
msgstr "Nur Fehler und Warnungen melden"

#: prefs.js:814
msgid "Off"
msgstr "Keine"

#: prefs.js:815
msgid "Report nothing at all"
msgstr "Gar nichts melden"

#: prefs.js:848
