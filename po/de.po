#: prefs.js:185 prefs.js:549 prefs.js:817 lib/menu.js:1811 lib/notify.js:32
msgid "Taildrop"
msgstr "Taildrop"

#: prefs.js:186
msgid "Send and receive files between Tailscale nodes."
msgstr "Dateien zwischen Tailscale-Geräten senden und empfangen."

#: prefs.js:226
msgid "Inbox folder (created if it does not exist)"
msgstr "Empfangsordner (wird bei Bedarf erstellt)"

#: prefs.js:242
msgid "Path is empty or not writable without admin privileges."
msgstr "Der Pfad ist leer oder ohne Administratorrechte nicht beschreibbar."

